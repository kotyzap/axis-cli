{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2020"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"],
  "// exclude": "Cloud-sync tools leave copies like 'info [conflicted].ts' next to the original. Without this they are type-checked and emitted into dist/, so a stale duplicate ships in the package.",
  "exclude": ["node_modules", "dist", "dist-test", "**/* [conflicted].ts", "**/*conflicted copy*.ts"]
}
